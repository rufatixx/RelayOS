<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0-alpha.1</Version>
    <Title>RelayOS.Core</Title>
    <Authors>Rufat Asadzade</Authors>
    <Company>RelayOS</Company>
    <Description>Experimental .NET foundation for encrypted, delay-tolerant message relay.</Description>
    <RepositoryUrl>https://github.com/rufatixx/RelayOS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rufatixx/RelayOS</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageTags>dotnet;csharp;delay-tolerant-networking;store-carry-forward;encrypted-messaging;offline-first</PackageTags>
    <PackageReleaseNotes>First public alpha: encrypted packets, durable queues, and an in-process store-carry-forward simulator.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Rufat Asadzade and RelayOS contributors.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
    <None Include="..\..\SECURITY.md" Pack="true" PackagePath="" />
    <None Include="..\..\TRADEMARKS.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
